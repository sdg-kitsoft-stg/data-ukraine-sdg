0456\u0437\u043d\u0438\u0447\u043d\u0430, \u043c\u043e\u0440\u0441\u044c\u043a\u0430, \u0440\u0456\u0447\u043a\u043e\u0432\u0430, \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0430, \u0442\u0440\u0443\u0431\u043e\u043f\u0440\u043e\u0432\u0456\u0434\u043d\u0430, \u0430\u0432\u0456\u0430\u0446\u0456\u0439\u043d\u0430, \u0456\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u0430\u0435\u0440\u043e\u0434\u0440\u043e\u043c\u0456\u0432 \u0442\u0430 \u0437\u043b\u0456\u0442\u043d\u043e-\u043f\u043e\u0441\u0430\u0434\u043a\u043e\u0432\u0438\u0445 \u043c\u0430\u0439\u0434\u0430\u043d\u0447\u0438\u043a\u0456\u0432, \u043c\u0456\u0441\u044c\u043a\u043e\u0433\u043e \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0443, \u043c\u0435\u0442\u0440\u043e\u043f\u043e\u043b\u0456\u0442\u0435\u043d\u0443 \u0442\u043e\u0449\u043e) \u0442\u0430 \u0456\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u0438\u0445 \u043a\u043e\u043c\u0443\u043d\u0456\u043a\u0430\u0446\u0456\u0439\u043d\u0438\u0445 \u043c\u0435\u0440\u0435\u0436; \u043e\u0445\u043e\u0440\u043e\u043d\u0430 \u0437\u0434\u043e\u0440\u043e\u0432\u2019\u044f, \u0433\u0440\u043e\u043c\u0430\u0434\u0441\u044c\u043a\u0435 \u0437\u0434\u043e\u0440\u043e\u0432\u2019\u044f; \u0442\u0443\u0440\u0438\u0437\u043c, \u0440\u0435\u043a\u0440\u0435\u0430\u0446\u0456\u044f, \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0430 (\u0443 \u0442\u043e\u043c\u0443 \u0447\u0438\u0441\u043b\u0456 \u0443\u043f\u0440\u0430\u0432\u043b\u0456\u043d\u043d\u044f \u0442\u0430/\u0430\u0431\u043e \u0435\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0456\u044f \u043f\u0430\u043c\u2019\u044f\u0442\u043e\u043a \u0430\u0440\u0445\u0456\u0442\u0435\u043a\u0442\u0443\u0440\u0438 \u0442\u0430 \u043e\u0431\u2019\u0454\u043a\u0442\u0430\u043c\u0438 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043d\u043e\u0457 \u0441\u043f\u0430\u0434\u0449\u0438\u043d\u0438) \u0442\u0430 \u0441\u043f\u043e\u0440\u0442; \u0443\u043f\u0440\u0430\u0432\u043b\u0456\u043d\u043d\u044f \u0432\u0456\u0434\u0445\u043e\u0434\u0430\u043c\u0438: \u0412\u0435\u0440\u0445\u043e\u0432\u043d\u043e\u044e \u0420\u0430\u0434\u043e\u044e \u0423\u043a\u0440\u0430\u0457\u043d\u0438 19.06.2025 \u0431\u0443\u043b\u043e \u043f\u0440\u0438\u0439\u043d\u044f\u0442\u043e \u0417\u0430\u043a\u043e\u043d \u0423\u043a\u0440\u0430\u0457\u043d\u0438 \u2116 4510-\u0406\u0425 \"\u041f\u0440\u043e \u043f\u0443\u0431\u043b\u0456\u0447\u043d\u043e-\u043f\u0440\u0438\u0432\u0430\u0442\u043d\u0435 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0441\u0442\u0432\u043e\" (\u0417\u0430\u043a\u043e\u043d \u2116 4510-\u0406\u0425), \u044f\u043a\u0438\u0439 \u043d\u0430\u0431\u0440\u0430\u0432 \u0447\u0438\u043d\u043d\u043e\u0441\u0442\u0456 31.10.2025 \u0442\u0430 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u043e \u0434\u043e \u044f\u043a\u043e\u0433\u043e \u0432\u0442\u0440\u0430\u0442\u0438\u0432 \u0447\u0438\u043d\u043d\u0456\u0441\u0442\u044c \u0417\u0430\u043a\u043e\u043d \u0423\u043a\u0440\u0430\u0457\u043d\u0438 \u2116 2404-VI \"\u041f\u0440\u043e \u0434\u0435\u0440\u0436\u0430\u0432\u043d\u043e-\u043f\u0440\u0438\u0432\u0430\u0442\u043d\u0435 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0441\u0442\u0432\u043e\". \u0417\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439 \u0417\u0430\u043a\u043e\u043d \u2116 4510-\u0406\u0425 \u0437\u0430\u043f\u0440\u043e\u0432\u0430\u0434\u0436\u0443\u0454 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u0438\u0439 \u043f\u0456\u0434\u0445\u0456\u0434 \u0434\u043e \u0440\u0435\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u0457 \u043c\u0435\u0445\u0430\u043d\u0456\u0437\u043c\u0443 \u043f\u0443\u0431\u043b\u0456\u0447\u043d\u043e-\u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e\u0433\u043e \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0441\u0442\u0432\u0430. \u0426\u0438\u043c \u0417\u0430\u043a\u043e\u043d\u043e\u043c \u0441\u0435\u0440\u0435\u0434 \u0456\u043d\u0448\u043e\u0433\u043e \u043e\u043d\u043e\u0432\u043b\u044e\u0454\u0442\u044c\u0441\u044f \u0442\u0435\u0440\u043c\u0456\u043d\u043e\u043b\u043e\u0433\u0456\u044f \u0443 \u0441\u0444\u0435\u0440\u0456 \u043f\u0443\u0431\u043b\u0456\u0447\u043d\u043e-\u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e\u0433\u043e \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0441\u0442\u0432\u0430 (\u0437\u043e\u043a\u0440\u0435\u043c\u0430, \u0442\u0435\u0440\u043c\u0456\u043d \"\u043f\u0443\u0431\u043b\u0456\u0447\u043d\u043e-\u043f\u0440\u0438\u0432\u0430\u0442\u043d\u0435 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0441\u0442\u0432\u043e\"). \u0412\u0456\u0434\u0442\u0430\u043a, \u043d\u0430\u0437\u0432\u0438 \u0456\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \"\u041a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u043f\u0440\u043e\u0435\u043a\u0442\u0456\u0432 \u0434\u0435\u0440\u0436\u0430\u0432\u043d\u043e-\u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e\u0433\u043e \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0441\u0442\u0432\u0430\" \u0442\u0430 \u0441\u0444\u0435\u0440\u0438 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d\u043e \u0443 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u0456\u0441\u0442\u044c \u0434\u043e \u0437\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u043e\u0433\u043e \u0417\u0430\u043a\u043e\u043d\u0443. <br> \u0421\u0444\u0435\u0440\u0438, \u0441\u0442\u0430\u043d \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f: \u0414\u043e 2020 \u0440\u043e\u043a\u0443 \u041c\u0456\u043d\u0435\u043a\u043e\u043d\u043e\u043c\u0456\u043a\u0438 \u043d\u0435 \u0431\u0443\u043b\u043e \u0434\u0435\u0440\u0436\u0430\u0442\u0435\u043b\u0435\u043c \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u0457 \u0449\u043e\u0434\u043e \u043a\u0456\u043b\u044c\u043a\u043e\u0441\u0442\u0456 \u0443\u043a\u043b\u0430\u0434\u0435\u043d\u0438\u0445 \u043a\u043e\u043d\u0446\u0435\u0441\u0456\u0439\u043d\u0438\u0445 \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0456\u0432, \u0441\u0442\u0430\u043d\u0443 \u0457\u0445 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f \u0442\u0430 \u0441\u0444\u0435\u0440 (\u0420\u0435\u0454\u0441\u0442\u0440 \u043a\u043e\u043d\u0446\u0435\u0441\u0456\u0439\u043d\u0438\u0445 \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0456\u0432 \u0431\u0443\u043b\u043e \u043f\u0435\u0440\u0435\u0434\u0430\u043d\u043e \u0424\u043e\u043d\u0434\u043e\u043c \u0434\u0435\u0440\u0436\u0430\u0432\u043d\u043e\u0433\u043e \u043c\u0430\u0439\u043d\u0430 \u0423\u043a\u0440\u0430\u0457\u043d\u0438 \u0434\u043e \u041c\u0456\u043d\u0456\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430 \u0440\u043e\u0437\u0432\u0438\u0442\u043a\u0443 \u0435\u043a\u043e\u043d\u043e\u043c\u0456\u043a\u0438, \u0442\u043e\u0440\u0433\u0456\u0432\u043b\u0456 \u0442\u0430 \u0441\u0456\u043b\u044c\u0441\u044c\u043a\u043e\u0433\u043e \u0433\u043e\u0441\u043f\u043e\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0423\u043a\u0440\u0430\u0457\u043d\u0438 \u043d\u0430\u043f\u0440\u0438\u043a\u0456\u043d\u0446\u0456 2019 \u0440\u043e\u043a\u0443 \u043d\u0430 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f \u043f\u0443\u043d\u043a\u0442\u0443 8 \u0440\u043e\u0437\u0434\u0456\u043b\u0443 \u0425\u0406\u0406 \"\u041f\u0440\u0438\u043a\u0456\u043d\u0446\u0435\u0432\u0456 \u0442\u0430 \u043f\u0435\u0440\u0435\u0445\u0456\u0434\u043d\u0456 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u044f\" \u0417\u0430\u043a\u043e\u043d\u0443 \u0423\u043a\u0440\u0430\u0457\u043d\u0438 \u0432\u0456\u0434 03.10.2019 \u2116 155-\u0406\u0425 \"\u041f\u0440\u043e \u043a\u043e\u043d\u0446\u0435\u0441\u0456\u044e\").","national_metadata_updated_date":"2026-08-04","national_data_updated_date":"2026-08-04","target_number":"17.2","goal_number":"17","indicator_sort_order":"17-02-01"}