u0438\u0445 \u0432\u043e\u0434\u043d\u0438\u0445 \u0431\u0456\u043e\u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0443 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u043e\u0431\u0441\u044f\u0437\u0456 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0445 \u043b\u0456\u043c\u0456\u0442\u0456\u0432 \u0441\u043a\u043b\u0430\u0434\u0430\u0454 \"\u2013\" \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0456 \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u043e\u0441\u0442\u0456 \u0432\u0438\u043b\u043e\u0432\u0443 \u0432\u043e\u0434\u043d\u0438\u0445 \u0431\u0456\u043e\u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0437 \u0442\u0438\u0445 \u0447\u0438 \u0456\u043d\u0448\u0438\u0445 \u043e\u0431\u0441\u0442\u0430\u0432\u0438\u043d, \u0430\u0431\u043e \u0441\u043f\u043e\u0441\u0456\u0431 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0432\u043e\u0434\u043d\u0438\u0445 \u0431\u0456\u043e\u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0431\u0443\u0432 \u043d\u0435 \u043b\u0456\u043c\u0456\u0442\u043e\u0432\u0430\u043d\u0438\u0439. <br> 2015\u20132016 \u0440\u043e\u043a\u0438: \u0414\u0430\u043d\u0456 \u0440\u043e\u0437\u0440\u043e\u0431\u043b\u044f\u044e\u0442\u044c\u0441\u044f \u0437 2017 \u0440\u043e\u043a\u0443. <br> 2022\u20132025 \u0440\u043e\u043a\u0438: \u041b\u0456\u043c\u0456\u0442\u0438 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0432\u043e\u0434\u043d\u0438\u0445 \u0431\u0456\u043e\u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u043e\u0434\u0435\u0440\u0436\u0430\u0432\u043d\u043e\u0433\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0432 \u0410\u0437\u043e\u0432\u0441\u044c\u043a\u043e\u043c\u0443 \u043c\u043e\u0440\u0456 \u0456\u0437 \u0437\u0430\u0442\u043e\u043a\u0430\u043c\u0438 \u0434\u043b\u044f \u0437\u0434\u0456\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u043c\u0438\u0441\u043b\u043e\u0432\u043e\u0433\u043e \u0440\u0438\u0431\u0430\u043b\u044c\u0441\u0442\u0432\u0430 \u0442\u0430 \u0434\u043e\u0441\u043b\u0456\u0434\u043d\u043e\u0433\u043e \u0432\u0438\u043b\u043e\u0432\u0443 \u043d\u0430 2025 \u0440\u0456\u043a \u043d\u0435 \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u043b\u0438\u0441\u044c. \u0417 2022 \u0440\u043e\u043a\u0443 \u0410\u0437\u043e\u0432\u0441\u044c\u043a\u0435 \u043c\u043e\u0440\u0435 \u0437\u0430\u043b\u0438\u0448\u0430\u0454\u0442\u044c\u0441\u044f \u0437\u0430\u043a\u0440\u0438\u0442\u0438\u043c \u0434\u043b\u044f \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u043c\u0438\u0441\u043b\u0443, \u0430 \u043d\u0435\u0437\u0430\u043a\u043e\u043d\u043d\u0438\u0439 \u0432\u0438\u043b\u043e\u0432 \u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0442\u044c \u043e\u043a\u0443\u043f\u0430\u043d\u0442\u0438. \u041f\u0440\u043e\u043c\u0438\u0441\u0435\u043b \u0432\u043e\u0434\u043d\u0438\u0445 \u0431\u0456\u043e\u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0432 \u0410\u0437\u043e\u0432\u0441\u044c\u043a\u043e\u043c\u0443 \u043c\u043e\u0440\u0456 \u0431\u0443\u0434\u0435 \u043c\u043e\u0436\u043b\u0438\u0432\u0438\u0439 \u043b\u0438\u0448\u0435 \u043f\u0456\u0441\u043b\u044f \u0434\u0435\u043e\u043a\u0443\u043f\u0430\u0446\u0456\u0457 \u0442\u0435\u0440\u0438\u0442\u043e\u0440\u0456\u0439. <br> 2022\u20132025 \u0440\u043e\u043a\u0438: \u0417 2022 \u0440\u043e\u043a\u0443 \u0432 \u0437\u0432\u2019\u044f\u0437\u043a\u0443 \u0437 \u0432\u0432\u0435\u0434\u0435\u043d\u043d\u044f\u043c \u0432\u043e\u0454\u043d\u043d\u043e\u0433\u043e \u0441\u0442\u0430\u043d\u0443 \u0432 \u0423\u043a\u0440\u0430\u0457\u043d\u0456, \u0437 \u043c\u0435\u0442\u043e\u044e \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u043d\u044f \u0431\u0435\u0437\u043f\u0435\u043a\u0438 \u0441\u0443\u0434\u043d\u043e\u043f\u043b\u0430\u0432\u0441\u0442\u0432\u0430, \u043c\u0456\u043d\u0456\u043c\u0456\u0437\u0430\u0446\u0456\u0457 \u0440\u0438\u0437\u0438\u043a\u0456\u0432 \u0434\u0438\u0432\u0435\u0440\u0441\u0456\u0439\u043d\u0438\u0445 \u0456 \u0442\u0435\u0440\u043e\u0440\u0438\u0441\u0442\u0438\u0447\u043d\u0438\u0445 \u0437\u0430\u0433\u0440\u043e\u0437 \u0437 \u043c\u043e\u0440\u044f \u0442\u0430 \u043d\u0435\u0434\u043e\u043f\u0443\u0449\u0435\u043d\u043d\u044f \u0437\u0430\u0433\u0438\u0431\u0435\u043b\u0456 \u0447\u0438 \u0442\u0440\u0430\u0432\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u0440\u0438\u0431\u0430\u043b\u043e\u043a \u0456 \u0446\u0438\u0432\u0456\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u043d\u044f, \u043f\u0440\u043e\u043c\u0438\u0441\u043b\u043e\u0432\u0435 \u0440\u0438\u0431\u0430\u043b\u044c\u0441\u0442\u0432\u043e \u0432 \u0427\u043e\u0440\u043d\u043e\u043c\u0443 \u043c\u043e\u0440\u0456 \u0442\u0430 \u0432 \u0447\u0430\u0441\u0442\u0438\u043d\u0456 \u0414\u043d\u0456\u043f\u0440\u043e\u0432\u0441\u044c\u043a\u043e-\u0411\u0443\u0437\u044c\u043a\u043e\u0457 \u0433\u0438\u0440\u043b\u043e\u0432\u043e\u0457 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 (\u0432 \u043c\u0435\u0436\u0430\u0445 \u0425\u0435\u0440\u0441\u043e\u043d\u0441\u044c\u043a\u043e\u0457 \u043e\u0431\u043b\u0430\u0441\u0442\u0456) \u0437\u0430\u0431\u043b\u043e\u043a\u043e\u0432\u0430\u043d\u0435. <br> 2024\u20132025 \u0440\u043e\u043a\u0438: \u041b\u0456\u043c\u0456\u0442\u0438 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0432\u043e\u0434\u043d\u0438\u0445 \u0431\u0456\u043e\u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u043e\u0434\u0435\u0440\u0436\u0430\u0432\u043d\u043e\u0433\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0432 \u0411\u0443\u0434\u0430\u0446\u044c\u043a\u043e\u043c\u0443 (\u0428\u0430\u0431\u043e\u043b\u0430\u0442\u0441\u044c\u043a\u043e\u043c\u0443) \u043b\u0438\u043c\u0430\u043d\u0456  \u0434\u043b\u044f \u0437\u0434\u0456\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u043c\u0438\u0441\u043b\u043e\u0432\u043e\u0433\u043e \u0440\u0438\u0431\u0430\u043b\u044c\u0441\u0442\u0432\u0430 \u0442\u0430 \u0434\u043e\u0441\u043b\u0456\u0434\u043d\u043e\u0433\u043e \u0432\u0438\u043b\u043e\u0432\u0443 \u043d\u0430 2024\u22122025 \u0440\u0456\u043a \u043d\u0435 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u044e\u0432\u0430\u043b\u0438\u0441\u044c. <br> 2022\u20132025 \u0440\u043e\u043a\u0438: \u041b\u0456\u043c\u0456\u0442\u0438 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0432\u043e\u0434\u043d\u0438\u0445 \u0431\u0456\u043e\u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u043e\u0434\u0435\u0440\u0436\u0430\u0432\u043d\u043e\u0433\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0432 \u0422\u0443\u0437\u043b\u043e\u0432\u0441\u044c\u043a\u0456\u0439 \u0433\u0440\u0443\u043f\u0456 \u043b\u0438\u043c\u0430\u043d\u0456\u0432 \u0434\u043b\u044f \u0437\u0434\u0456\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u043c\u0438\u0441\u043b\u043e\u0432\u043e\u0433\u043e \u0440\u0438\u0431\u0430\u043b\u044c\u0441\u0442\u0432\u0430 \u0442\u0430 \u0434\u043e\u0441\u043b\u0456\u0434\u043d\u043e\u0433\u043e \u0432\u0438\u043b\u043e\u0432\u0443 \u043d\u0430 2022\u22122025 \u0440\u0456\u043a \u043d\u0435 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u044e\u0432\u0430\u043b\u0438\u0441\u044c. <br> 2025 \u0440\u0456\u043a: \u0412\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u043e \u0434\u043e \u043d\u0430\u043a\u0430\u0437\u0456\u0432 \u041c\u0456\u043d\u0430\u0433\u0440\u043e\u043f\u043e\u043b\u0456\u0442\u0438\u043a\u0438 \u0432\u0456\u0434 31.10.2024  \u2116 4039 \"\u041f\u0440\u043e \u0437\u0430\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u043d\u044f \u043b\u0456\u043c\u0456\u0442\u0456\u0432 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0432\u043e\u0434\u043d\u0438\u0445 \u0431\u0456\u043e\u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u043e\u0434\u0435\u0440\u0436\u0430\u0432\u043d\u043e\u0433\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0443 \u0440\u0438\u0431\u043e\u0433\u043e\u0441\u043f\u043e\u0434\u0430\u0440\u0441\u044c\u043a\u0438\u0445 \u0432\u043e\u0434\u043d\u0438\u0445 \u043e\u0431\u2019\u0454\u043a\u0442\u0430\u0445 (\u0457\u0445 \u0447\u0430\u0441\u0442\u0438\u043d\u0430\u0445) (\u043a\u0440\u0456\u043c \u0410\u0437\u043e\u0432\u0441\u044c\u043a\u043e\u0433\u043e \u0442\u0430 \u0427\u043e\u0440\u043d\u043e\u0433\u043e \u043c\u043e\u0440\u0456\u0432 \u0456\u0437 \u0437\u0430\u0442\u043e\u043a\u0430\u043c\u0438, \u043f\u0440\u0438\u0447\u043e\u0440\u043d\u043e\u043c\u043e\u0440\u0441\u044c\u043a\u0438\u0445 \u043b\u0438\u043c\u0430\u043d\u0456\u0432, \u0440\u0456\u0447\u043a\u0438 \u0414\u0443\u043d\u0430\u0439, \u043f\u043e\u043d\u0438\u0437\u0437\u044f \u0440\u0456\u0447\u043a\u0438 \u0414\u043d\u0456\u0441\u0442\u0435\u0440 (\u0437 \u043e\u0437\u0435\u0440\u0430\u043c\u0438, \u0440\u0443\u043a\u0430\u0432\u043e\u043c \u0422\u0443\u0440\u0443\u043d\u0447\u0443\u043a) \u0442\u0430 \u0414\u043d\u0456\u0441\u0442\u0440\u043e\u0432\u0441\u044c\u043a\u043e\u0433\u043e \u043b\u0438\u043c\u0430\u043d\u0443) \u0434\u043b\u044f \u0437\u0434\u0456\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u043c\u0438\u0441\u043b\u043e\u0432\u043e\u0433\u043e \u0440\u0438\u0431\u0430\u043b\u044c\u0441\u0442\u0432\u0430 \u0442\u0430 \u0434\u043e\u0441\u043b\u0456\u0434\u043d\u043e\u0433\u043e \u0432\u0438\u043b\u043e\u0432\u0443 \u043d\u0430 2025 \u0440\u0456\u043a\" \u0442\u0430 \u0432\u0456\u0434 31.10.2024 \u2116 4040 \"\u041f\u0440\u043e \u0437\u0430\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u043d\u044f \u043b\u0456\u043c\u0456\u0442\u0456\u0432 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0432\u043e\u0434\u043d\u0438\u0445 \u0431\u0456\u043e\u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u043e\u0434\u0435\u0440\u0436\u0430\u0432\u043d\u043e\u0433\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0443 \u0427\u043e\u0440\u043d\u043e\u043c\u0443 \u043c\u043e\u0440\u0456 \u0456\u0437 \u0437\u0430\u0442\u043e\u043a\u0430\u043c\u0438, \u043f\u0440\u0438\u0447\u043e\u0440\u043d\u043e\u043c\u043e\u0440\u0441\u044c\u043a\u0438\u0445 \u043b\u0438\u043c\u0430\u043d\u0430\u0445, \u0440\u0456\u0447\u0446\u0456 \u0414\u0443\u043d\u0430\u0439, \u043f\u043e\u043d\u0438\u0437\u0437\u0456 \u0440\u0456\u0447\u043a\u0438 \u0414\u043d\u0456\u0441\u0442\u0435\u0440 (\u0437 \u043e\u0437\u0435\u0440\u0430\u043c\u0438, \u0440\u0443\u043a\u0430\u0432\u043e\u043c \u0422\u0443\u0440\u0443\u043d\u0447\u0443\u043a) \u0442\u0430 \u0414\u043d\u0456\u0441\u0442\u0440\u043e\u0432\u0441\u044c\u043a\u043e\u043c\u0443 \u043b\u0438\u043c\u0430\u043d\u0456 \u0434\u043b\u044f \u0437\u0434\u0456\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u043c\u0438\u0441\u043b\u043e\u0432\u043e\u0433\u043e \u0440\u0438\u0431\u0430\u043b\u044c\u0441\u0442\u0432\u0430 \u0442\u0430 \u0434\u043e\u0441\u043b\u0456\u0434\u043d\u043e\u0433\u043e \u0432\u0438\u043b\u043e\u0432\u0443 \u043d\u0430 2025 \u0440\u0456\u043a\" \u0432\u043e\u0434\u043d\u0456 \u0431\u0456\u043e\u0440\u0435\u0441\u0443\u0440\u0441\u0438 \u0433\u043e\u0441\u0442\u0440\u043e\u043d\u0456\u0441, \u043b\u043e\u0431\u0430\u043d\u044c \u0442\u0430 \u0441\u0438\u043d\u0433\u0456\u043b\u044c \u0437\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0456, \u044f\u043a \u043a\u0435\u0444\u0430\u043b\u0435\u0432\u0456 (\u0433\u043e\u0441\u0442\u0440\u043e\u043d\u0456\u0441, \u043b\u043e\u0431\u0430\u043d\u044c, \u0441\u0438\u043d\u0433\u0456\u043b\u044c). <br> \u0420\u0430\u0437\u043e\u043c \u0437 \u0442\u0438\u043c, \u0443 2025 \u0440\u043e\u0446\u0456 \u0437\u0430\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u0456 \u043b\u0456\u043c\u0456\u0442\u0438 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0432\u043e\u0434\u043d\u0438\u0445 \u0431\u0456\u043e\u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0443 \u0422\u0438\u043b\u0456\u0433\u0443\u043b\u044c\u0441\u044c\u043a\u043e\u043c\u0443 \u043b\u0438\u043c\u0430\u043d\u0456 \u043f\u043e \u0445\u0430\u043c\u0441\u0456 (\u0447\u043e\u0440\u043d\u043e\u043c\u043e\u0440\u0441\u044c\u043a\u0456\u0439), \u0443 \u0411\u0435\u0440\u0435\u0437\u0430\u043d\u0441\u044c\u043a\u043e\u043c\u0443 \u043b\u0438\u043c\u0430\u043d\u0456 \u2212 \u0442\u0430\u0440\u0430\u043d\u044f (\u043f\u043b\u0456\u0442\u043a\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043d\u0430), \u0445\u0430\u043c\u0441\u0430 (\u0447\u043e\u0440\u043d\u043e\u043c\u043e\u0440\u0441\u044c\u043a\u0430) \u0442\u0430 \u043a\u0430\u0440\u0430\u0441\u044c \u0441\u0440\u0456\u0431\u043b\u044f\u0441\u0442\u0438\u0439, \u0443 \u043f\u043e\u043d\u0438\u0437\u0437\u0456 \u0414\u043d\u0456\u0441\u0442\u0440\u0430 \u0437 \u043e\u0437\u0435\u0440\u0430\u043c\u0438 \u0442\u0430 \u0414\u043d\u0456\u0441\u0442\u0440\u043e\u0432\u0441\u044c\u043a\u043e\u043c\u0443 \u043b\u0438\u043c\u0430\u043d\u0456 \u2212 \u0430\u0442\u0435\u0440\u0438\u043d\u0430 \u043f\u0456\u0449\u0430\u043d\u0430 \u0442\u0430 \u043a\u0440\u0435\u0432\u0435\u0442\u043a\u0430, \u0443 \u0414\u043d\u0456\u043f\u0440\u043e\u0432\u0441\u044c\u043a\u043e-\u0411\u0443\u0437\u044c\u043a\u0456\u0439 \u0433\u0438\u0440\u043b\u043e\u0432\u0456\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0456 \u2212 \u0441\u0438\u043d\u0435\u0446\u044c \u0437\u0432\u0438\u0447\u0430\u0439\u043d\u0438\u0439, \u0443 \u0427\u043e\u0440\u043d\u043e\u043c\u0443 \u043c\u043e\u0440\u0456 \u2212 \u0430\u0440\u0442\u0435\u043c\u0456\u044f \u0441\u0430\u043b\u0456\u043d\u0430 (\u0440\u0430\u0447\u043a\u0438), \u0430\u0440\u0442\u0435\u043c\u0456\u044f \u0441\u0430\u043b\u0456\u043d\u0430 (\u044f\u0439\u0446\u044f), \u043a\u0430\u0442\u0440\u0430\u043d \u043a\u043e\u0440\u043e\u0442\u043a\u043e\u043f\u0435\u0440\u0438\u0439, \u043a\u0443\u043d\u0456\u0430\u0440\u043a\u0430 (\u0441\u043a\u0430\u0444\u0430\u0440\u043a\u0430), \u043c\u0435\u0434\u0443\u0437\u0438, \u043c\u043e\u0442\u0438\u043b\u044c (\u043b\u0438\u0447\u0438\u043d\u043a\u0438 \u0445\u0456\u0440\u043e\u043d\u043e\u043c\u0456\u0434) \u0442\u0430 \u043f\u0443\u0437\u0430\u043d\u043e\u043a. \u041b\u0456\u043c\u0456\u0442 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0432\u043e\u0434\u043d\u0438\u0445 \u0431\u0456\u043e\u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0443 \u043f\u043e\u043d\u0438\u0437\u0437\u0456 \u0414\u043d\u0456\u0441\u0442\u0440\u0430 \u0437 \u043e\u0437\u0435\u0440\u0430\u043c\u0438 \u0442\u0430 \u0414\u043d\u0456\u0441\u0442\u0440\u043e\u0432\u0441\u044c\u043a\u043e\u043c\u0443 \u043b\u0438\u043c\u0430\u043d\u0456 \u043f\u043e \u0440\u0430\u043a\u0430\u0445 \u043d\u0435 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u044e\u0432\u0430\u0432\u0441\u044f \u043d\u0430 2025 \u0440\u0456\u043a.","national_metadata_updated_date":"2026-08-04","national_data_updated_date":"2026-08-04","target_number":"14.3","goal_number":"14","indicator_sort_order":"14-03-01"}